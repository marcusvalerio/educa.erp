# Copie este arquivo para .env.local e preencha com as credenciais do
# projeto Supabase já existente. NUNCA commitar o .env.local (já está
# coberto pela regra `.env*` no .gitignore).

# Painel do projeto no Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# Chave privada — usada SOMENTE em código server-side (API routes).
# Nunca deve ser referenciada em um componente "use client".
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_SECRETA

# Opcional: usado apenas para rodar `supabase db push` / `supabase link`
# via CLI a partir desta máquina (não é lido pela aplicação Next.js).
# Painel do projeto: Project Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=seu-projeto-ref
