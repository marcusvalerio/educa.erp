# Copie este arquivo para .env.local e preencha com as credenciais do
# projeto Supabase já existente. NUNCA commitar o .env.local (já está
# coberto pela regra `.env*` no .gitignore).

# Painel do projeto no Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# Chave privada — usada SOMENTE em código server-side (API routes).
# Nunca deve ser referenciada em um componente "use client".
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_SECRETA

# Opcional: usado apenas para rodar `supabase db push` / `supabase link`
# via CLI a partir desta máquina (não é lido pela aplicação Next.js).
# Painel do projeto: Project Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=seu-projeto-ref

# URL pública do app, usada nos links de convite enviados por e-mail
# (server-only). Sem ela, o servidor usa a origem da requisição — que o
# Supabase ainda restringe à lista de Redirect URLs do projeto.
APP_URL=https://seu-dominio.exemplo

# Provedor de login (entra no build: mudar exige redeploy). Padrão: supabase.
# Para o Neon Auth (docs/NEON_AUTH_MIGRATION.md §13), defina neon e as
# variáveis abaixo — todas server-only.
# AUTH_PROVIDER=neon
# NEON_AUTH_BASE_URL=https://EP.neonauth.REGIAO.aws.neon.tech/neondb/auth
# NEON_AUTH_SERVICE_EMAIL=gerado por scripts/neon-service-account.mjs
# NEON_AUTH_SERVICE_PASSWORD=gerado por scripts/neon-service-account.mjs
# Painel do Supabase: Project Settings > API > JWT Settings (segredo legado)
# SUPABASE_JWT_SECRET=SEU_SEGREDO_JWT

# Integração ORION.WMS (README, seção "Integração com o ORION.WMS") — server-only.
# ORION_URL=https://orion.exemplo.com.br
# ORION_INSTALL_KEY_ID=install-1
# ORION_INSTALL_SECRET=GERE_UM_SEGREDO_LONGO
# INTEGRATION_ENCRYPTION_KEY=32_BYTES_EM_BASE64
# ATLAS_SSO_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"atlas-sso-2026-11",...}  (node scripts/orion-sso-keygen.mjs)
# ATLAS_SSO_PREVIOUS_PUBLIC_JWKS={"keys":[]}
# CRON_SECRET=GERE_UM_SEGREDO_LONGO
